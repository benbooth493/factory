{
  "owner": "benbooth493",
  "project_number": 1,
  "repo": "benbooth493/my-app",
  "base_branch": "main",
  "status_field": "Status",
  "columns": {
    "backlog": "Backlog",
    "ready": "Ready",
    "build": "Build",
    "qa": "QA",
    "review": "Review",
    "done": "Done",
    "blocked": "Blocked"
  },
  "verify_commands": ["make test"],
  "max_parallel": 3,
  "max_bounces": 2,
  "merge_method": "squash",
  "auto_merge": true,
  "models": {
    "build": "sonnet",
    "qa": "sonnet",
    "review": "opus"
  },
  "collect": {
    "since": "14d",
    "sentry": {
      "enabled": true,
      "host": "https://sentry.io",
      "org": "my-org",
      "project": "my-app",
      "environment": "production",
      "min_events": 5,
      "min_users": 1,
      "limit": 25
    },
    "posthog": {
      "enabled": true,
      "host": "https://eu.posthog.com",
      "project_id": 12345,
      "min_events": 10,
      "min_users": 2,
      "limit": 25,
      "slow_lcp_ms": 2500,
      "failure_events": ["checkout_failed", "signup_error"],
      "signals": ["exceptions", "rageclicks", "deadclicks", "slow_pages", "failures", "surveys", "pageview_paths"]
    }
  }
}
