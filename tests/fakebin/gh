#!/usr/bin/env bash
# Fake gh for tests: answers from fixtures and logs every call to $GH_LOG.
set -euo pipefail
fx="$(cd "$(dirname "$0")/../fixtures" && pwd)"
echo "gh $*" >> "${GH_LOG:-/dev/null}"

# FAKE_BOARD (a JSON file {options:[{id,name,color,description}], items:[...]})
# makes the board stateful: item-list, item-edit and the Status options
# GraphQL read and write it, like GitHub would. A rewrite of the options gives
# every option a new id and clears every card's Status, as GitHub may.
board_mode() {
  local jqf="" id="" opt="" new
  case "$1 ${2:-}" in
    "project item-list") jq '{items: .items}' "$FAKE_BOARD" ;;
    "project item-edit")
      while [ $# -gt 0 ]; do
        case "$1" in --id) id="$2" ;; --single-select-option-id) opt="$2" ;; esac
        shift
      done
      new=$(jq --arg id "$id" --arg o "$opt" '
        (.options | map(select(.id == $o)) | first | .name) as $n
        | if $n == null then error("no option \($o)") else . end
        | .items |= map(if .id == $id then .status = $n else . end)' "$FAKE_BOARD") || exit 1
      printf '%s\n' "$new" > "$FAKE_BOARD"; echo '{}' ;;
    "api graphql")
      while [ $# -gt 0 ]; do [ "$1" = "--jq" ] && jqf="$2"; shift; done
      new=$(cat)
      printf '%s\n' "$new" >> "${GH_LOG:-/dev/null}"
      if jq -e '.query | contains("updateProjectV2Field")' <<<"$new" >/dev/null; then
        [ -z "${FAKE_GRAPHQL_FAIL:-}" ] || { echo "fake gh: graphql failed" >&2; exit 1; }
        jq --argjson v "$(jq '.variables.opts' <<<"$new")" \
          '.options = [$v | to_entries[] | .value + {id: "new_\(.key)"}] | .items |= map(.status = null)' \
          "$FAKE_BOARD" > "$FAKE_BOARD.tmp" && mv "$FAKE_BOARD.tmp" "$FAKE_BOARD"
        echo '{"data":{}}'
      else
        jq "{data: {node: {options: .options}}} | ${jqf:-.}" "$FAKE_BOARD"
      fi ;;
    *) return 1 ;;
  esac
}
if [ -n "${FAKE_BOARD:-}" ] && board_mode "$@"; then exit 0; fi

case "$1 ${2:-}" in
  "api graphql")
    # Board reads from board.sh. Items come from FAKE_ITEMS (a JSON file
    # {nodes:[...]}, default fixtures/items.json), all in one page.
    # FAKE_RATE_LIMIT makes GitHub refuse like its secondary rate limit.
    [ -z "${FAKE_RATE_LIMIT:-}" ] || { echo "GraphQL: API rate limit exceeded for user ID 1." >&2; exit 1; }
    q="" num="" st="" jqf="."
    while [ $# -gt 0 ]; do
      case "$1" in
        -f|-F) case "$2" in query=*) q="${2#query=}" ;; number=*) num="${2#number=}" ;; status=*) st="${2#status=}" ;; esac; shift ;;
        --jq) jqf="$2"; shift ;;
      esac
      shift
    done
    items="${FAKE_ITEMS:-$fx/items.json}"
    case "$q" in
      *projectItems*)
        jq --argjson n "$num" --arg st "$st" --slurpfile f "$fx/fields.json" '
          ($f[0].fields[] | select(.name == $st) | {id, options}) as $field
          | {data: {repository: {issue: {projectItems: {nodes: [ .nodes[] | select(.content.number == $n)
              | {id, project: {id: "PVT_project", number: 5, url: "https://github.com/users/acme/projects/5", field: $field}} ]}}}}}' "$items" ;;
      *) jq "{data: {repositoryOwner: {projectV2: {items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: .nodes}}}}} | $jqf" "$items" ;;
    esac ;;
  "project field-list") cat "$fx/fields.json" ;;
  "project view") echo "PVT_project" ;;
  "project item-edit") echo '{}' ;;
  "api rate_limit") echo 4000 ;;
  "issue view")
    # FAKE_ISSUE (a JSON object) answers full views; otherwise labels come
    # from FAKE_LABELS (JSON array), default none
    if [ -n "${FAKE_ISSUE:-}" ]; then echo "$FAKE_ISSUE"; else echo "${FAKE_LABELS:-[]}"; fi ;;
  "issue edit"|"issue comment"|"label create") : ;;
  "pr comment")
    # keep comment bodies sent on stdin, so tests can read them
    case " $* " in *" --body-file - "*) cat >> "${GH_LOG:-/dev/null}" ;; esac ;;
  "pr view")
    # FAKE_PR_LABELS: label names, FAKE_FILES: [{path,additions,deletions}],
    # FAKE_CLOSES: issue numbers the PR closes (all JSON arrays)
    # labels added by "pr edit" in this run show up too
    added='[]'
    [ ! -f "${GH_LOG:-}.labels" ] || added=$(jq -Rn '[inputs]' "$GH_LOG.labels")
    default_files='[{"path":"b.txt","additions":1,"deletions":0}]'
    # FAKE_HEAD_REF (<git dir>:<branch>): the head follows that branch, as a
    # push to the PR branch would move it. FAKE_CONFLICTING_AT: the head sha
    # GitHub calls conflicting. FAKE_PENDING_VIEWS=N: the first N views of a
    # head other than FAKE_HEAD show its check as pending.
    h="${FAKE_HEAD:?}" m="${FAKE_MERGEABLE:-MERGEABLE}" c="${FAKE_CHECK:-SUCCESS}"
    [ -z "${FAKE_HEAD_REF:-}" ] || h=$(git --git-dir "${FAKE_HEAD_REF%%:*}" rev-parse "${FAKE_HEAD_REF#*:}")
    [ "${FAKE_CONFLICTING_AT:-}" != "$h" ] || m=CONFLICTING
    if [ "$h" != "$FAKE_HEAD" ] && [ -n "${FAKE_PENDING_VIEWS:-}" ]; then
      n=$(cat "$GH_LOG.views" 2>/dev/null || echo 0)
      if [ "$n" -lt "$FAKE_PENDING_VIEWS" ]; then echo $((n + 1)) > "$GH_LOG.views"; c=PENDING; fi
    fi
    jq -n --arg h "$h" --arg m "$m" --arg c "$c" \
      --argjson l "${FAKE_PR_LABELS:-[]}" --argjson a "$added" --argjson f "${FAKE_FILES:-$default_files}" \
      --argjson i "${FAKE_CLOSES:-[]}" \
      '{headRefOid:$h, headRefName:"factory/3", baseRefName:"main", mergeable:$m, isDraft:true,
        state:"OPEN", statusCheckRollup:[{conclusion:$c}],
        labels:[($l + $a)[] | {name:.}], files:$f, changedFiles:($f | length),
        additions:([$f[].additions] | add // 0), deletions:([$f[].deletions] | add // 0),
        closingIssuesReferences:[$i[] | {number:.}]}' ;;
  "pr list")
    # FAKE_PRS: open PRs as [{headRefName, files:[{path}]}], default none
    # FAKE_PR_LIST_FAIL: fail with this message instead
    [ -z "${FAKE_PR_LIST_FAIL:-}" ] || { echo "$FAKE_PR_LIST_FAIL" >&2; exit 1; }
    jqf="."
    while [ $# -gt 0 ]; do [ "$1" != "--jq" ] || jqf="$2"; shift; done
    jq "$jqf" <<<"${FAKE_PRS:-[]}" ;;
  "pr ready"|"pr merge") : ;;
  "pr edit")
    # FAKE_EDIT_FAIL=N fails the first N label edits like a network timeout.
    # Labels that land are kept in $GH_LOG.labels, which "pr view" reads.
    [ -n "${GH_LOG:-}" ] || exit 0
    case " $* " in *" --add-label "*)
      n=$(cat "$GH_LOG.editfails" 2>/dev/null || echo 0)
      if [ "$n" -lt "${FAKE_EDIT_FAIL:-0}" ]; then
        echo $((n + 1)) > "$GH_LOG.editfails"
        echo "fake gh: dial tcp: i/o timeout" >&2; exit 1
      fi
      while [ $# -gt 0 ]; do [ "$1" != "--add-label" ] || echo "$2" >> "$GH_LOG.labels"; shift; done ;;
    esac ;;
  "pr diff") printf 'diff --git a/db/migrate.sql b/db/migrate.sql\n+ALTER TABLE users DROP COLUMN email;\n' ;;
  "auth status") echo "  - Token scopes: 'project', 'repo'" ;;
  "repo view") echo '{}' ;;
  *) echo "fake gh: unhandled: $*" >&2; exit 1 ;;
esac
